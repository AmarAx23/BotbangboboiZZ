# LINE Developers Console -> your channel -> Messaging API tab
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Claude Console (platform.claude.com/settings/keys) -> Create Key
# Used for reading document photos, parsing "นัด..." chat messages, and the
# "ถามบอท:" Q&A.
ANTHROPIC_API_KEY=

# Optional - only needed for voice message support. Claude's API doesn't
# accept audio input, so that one feature (only that one) uses Gemini
# instead. Get a free key at aistudio.google.com/app/apikey. Leave blank to
# just disable voice messages; everything else works fine without it.
GEMINI_API_KEY=

# Cloudflare R2 (dashboard.cloudflare.com -> R2 Object Storage -> Overview)
# R2_ACCOUNT_ID is just the account id (no https://, no .r2.cloudflarestorage.com)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL from bucket Settings -> Public Development URL, e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL_BASE=

# Local SQLite file path (leave as-is unless you need something else)
DATABASE_PATH=reminders.db

# Public base URL of this app itself, no trailing slash (e.g. your Render
# URL: https://your-app.onrender.com) - used to build links to the web
# report summary page. Leave blank to just send the raw Excel link instead,
# same as before this feature existed.
BASE_URL=

# LINE group ID that all confirmed reminders get pushed to (the
# "employee" group). Leave blank until you've captured it - see README.
EMPLOYEE_GROUP_ID=

# --- Google Calendar sync (optional) ---
# Leave GOOGLE_CALENDAR_ID blank to skip Calendar sync entirely.
# Calendar ID of a calendar shared with the service account below, at
# "เปลี่ยนแปลงกิจกรรม" (Make changes to events) permission or higher.
GOOGLE_CALENDAR_ID=
# Path to a service-account JSON key file - used when running locally.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json
# Or: paste the whole service-account JSON here instead (handy on hosts
# like Railway/Render with no file upload). Takes priority if both are set.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Reminder timing ---
TIMEZONE=Asia/Bangkok
# Minutes before the meeting to send an extra heads-up (on top of the
# existing at-time push). Set to 0 to disable.
REMINDER_MINUTES_BEFORE=15
# Hour (0-23, local TIMEZONE) to push the daily summary of today's
# reminders. Set MORNING_BRIEF_ENABLED=0 to disable entirely.
MORNING_BRIEF_HOUR=7
MORNING_BRIEF_ENABLED=1

# Hour/minute (0-23 / 0-59) to push the running summary of every reminder
# in the current month - sent every morning (gated by MORNING_BRIEF_ENABLED
# above, not a separate toggle).
MONTHLY_APPOINTMENT_BRIEF_HOUR=6
MONTHLY_APPOINTMENT_BRIEF_MINUTE=55

# --- Monthly report (optional) ---
# Auto-generates an Excel summary of last month's documents and pushes the
# R2 download link to the employee group on this day/hour each month.
# Always available on demand too, by typing "รายงานเดือนนี้" to the bot.
MONTHLY_REPORT_ENABLED=1
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_HOUR=8

# --- Weekly report (optional) ---
# Same idea, but for the prior Mon-Sun week, pushed every Monday morning.
# Always available on demand too, by typing "รายงานสัปดาห์นี้".
WEEKLY_REPORT_ENABLED=1
WEEKLY_REPORT_HOUR=8

# --- Collision detection ---
# When confirming/rescheduling a reminder, warn (but don't block) if
# another reminder already exists within this many minutes of it.
COLLISION_WINDOW_MINUTES=60

# --- Recurring appointments ---
# Hour/minute (local TIMEZONE) the scheduler checks "นัดประจำ ทุก..." rules
# and generates that day's reminder if today's weekday matches.
RECURRING_GENERATE_HOUR=0
RECURRING_GENERATE_MINUTE=10

# --- Nightly database backup (optional) ---
# Uploads a copy of the local SQLite file to R2 every night (same bucket/
# credentials as everything else) so reminders/documents survive a lost
# or reset machine.
BACKUP_ENABLED=1
BACKUP_HOUR=2
